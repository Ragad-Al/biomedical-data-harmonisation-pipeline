profiles {
  // Plain local (system Python)
  local {
    process.executor = 'local'
    process.errorStrategy = 'retry'
    process.maxRetries    = 2
    process.maxErrors     = '-1'
    executor {
      submitRateLimit = '10 sec'
    }
  }

  // Apptainer/Singularity
  apptainer {
    process.executor = 'local'
    process.container = "${params.container ?: 'your_image.sif'}"
    apptainer {
      enabled = true
      autoMounts = true
      runOptions = '--cleanenv'   // add bind mounts if needed
    }
    // if scripts aren’t in PATH inside the image, add: process.shell = ['/bin/bash','-le']
  }

  // Conda (alternative)
  conda {
    process.conda = "${params.conda_env ?: 'envs/smartway.yml'}"
    conda.enabled = true
  }
}

// Defaults you can override via params.yaml or CLI
params {
  outdir = "results"
  sample_folder = "samples"

  entity_file  = []
  sample_file  = []

  // optional downstream files
  mutation_file         = null
  mutation_source       = null
  sv_file               = null
  sv_source             = null
  rnaseq_file           = null
  methylation_file      = null
  methylation_manifest  = null

  // container, conda_env can be set here or on the CLI
}
